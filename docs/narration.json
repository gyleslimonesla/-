{
  "sampleRate": 48000,
  "duration": 150,
  "cues": [
    {
      "id": 1,
      "start": 7.6,
      "end": 11,
      "text": "每一个名字，都曾是一首诗。"
    },
    {
      "id": 2,
      "start": 14.6,
      "end": 19.4,
      "text": "俳句，来自日本。五、七、五，共十七个音。"
    },
    {
      "id": 3,
      "start": 20.4,
      "end": 25.6,
      "text": "用最少的语言，留住一个瞬间。"
    },
    {
      "id": 4,
      "start": 26.6,
      "end": 31.6,
      "text": "一片叶落，一声水响，世界就在其中。"
    },
    {
      "id": 5,
      "start": 40.4,
      "end": 46.2,
      "text": "十四行诗，名字来自意大利语 sonetto，意思是“小小的歌”。"
    },
    {
      "id": 6,
      "start": 47.6,
      "end": 52.6,
      "text": "十四行，不多一行，也不少一行。"
    },
    {
      "id": 7,
      "start": 53.8,
      "end": 59.4,
      "text": "情感在格律之中，被韵律雕刻成形。"
    },
    {
      "id": 8,
      "start": 68.4,
      "end": 73.4,
      "text": "Opus，是拉丁语里的“作品”。"
    },
    {
      "id": 9,
      "start": 74.6,
      "end": 81,
      "text": "音乐家用它为乐曲编号；毕生的杰作，被称为 magnum opus。"
    },
    {
      "id": 10,
      "start": 82.4,
      "end": 87.8,
      "text": "当结构足够宏大，创造便有了殿堂。"
    },
    {
      "id": 11,
      "start": 96.2,
      "end": 101.6,
      "text": "Fable，源自拉丁语 fabula，意思是“被讲述的事”。"
    },
    {
      "id": 12,
      "start": 102.8,
      "end": 108,
      "text": "狐狸开口说话，智慧便藏进了故事。"
    },
    {
      "id": 13,
      "start": 109,
      "end": 113.4,
      "text": "故事，从这里开始呼吸。"
    },
    {
      "id": 14,
      "start": 121.2,
      "end": 126.6,
      "text": "Mythos，来自希腊语 μῦθος：言说、故事，乃至神话。"
    },
    {
      "id": 15,
      "start": 127.8,
      "end": 133.6,
      "text": "当故事被一代代人讲述，它就成为我们理解世界的方式。"
    },
    {
      "id": 16,
      "start": 134.6,
      "end": 138.6,
      "text": "寓言与神话，本是同一个故事。"
    },
    {
      "id": 17,
      "start": 143.4,
      "end": 147.6,
      "text": "语言为智慧命名，故事让名字拥有世界。"
    }
  ]
}