{
  "sampleRate": 48000,
  "duration": 180,
  "cues": [
    {
      "id": 1,
      "start": 2.4,
      "end": 7.2,
      "text": "一千三百年前，有人在江边，问了月亮一句话"
    },
    {
      "id": 2,
      "start": 15.8,
      "end": 19,
      "text": "潮水把月亮，托出了海面"
    },
    {
      "id": 3,
      "start": 19.3,
      "end": 27.6,
      "text": "春江潮水连海平，海上明月共潮生"
    },
    {
      "id": 4,
      "start": 28.6,
      "end": 37.4,
      "text": "江畔何人初见月，江月何年初照人"
    },
    {
      "id": 5,
      "start": 32.6,
      "end": 37.4,
      "text": "这一问，至今无人能答"
    },
    {
      "id": 6,
      "start": 41.8,
      "end": 45.4,
      "text": "雨停了，山把声音还给泉水"
    },
    {
      "id": 7,
      "start": 45.8,
      "end": 52.6,
      "text": "空山新雨后，天气晚来秋"
    },
    {
      "id": 8,
      "start": 53.2,
      "end": 60.6,
      "text": "明月松间照，清泉石上流"
    },
    {
      "id": 9,
      "start": 64.8,
      "end": 68.4,
      "text": "月亮落下去的时候，有一个人没有睡"
    },
    {
      "id": 10,
      "start": 68.8,
      "end": 75.6,
      "text": "月落乌啼霜满天，江枫渔火对愁眠"
    },
    {
      "id": 11,
      "start": 76.2,
      "end": 84.6,
      "text": "姑苏城外寒山寺，夜半钟声到客船"
    },
    {
      "id": 12,
      "start": 80.8,
      "end": 85.2,
      "text": "那一声钟，响了一千二百年"
    },
    {
      "id": 13,
      "start": 88.6,
      "end": 91.6,
      "text": "流放的路走到一半，赦书到了"
    },
    {
      "id": 14,
      "start": 91.9,
      "end": 98.6,
      "text": "朝辞白帝彩云间，千里江陵一日还"
    },
    {
      "id": 15,
      "start": 99.2,
      "end": 106.6,
      "text": "两岸猿声啼不住，轻舟已过万重山"
    },
    {
      "id": 16,
      "start": 110.8,
      "end": 113.4,
      "text": "晴也好"
    },
    {
      "id": 17,
      "start": 113.7,
      "end": 120.2,
      "text": "水光潋滟晴方好，山色空蒙雨亦奇"
    },
    {
      "id": 18,
      "start": 120.4,
      "end": 123.8,
      "text": "雨也好"
    },
    {
      "id": 19,
      "start": 123.8,
      "end": 130.2,
      "text": "欲把西湖比西子，淡妆浓抹总相宜"
    },
    {
      "id": 20,
      "start": 132.2,
      "end": 138.4,
      "text": "落霞与孤鹜齐飞，秋水共长天一色"
    },
    {
      "id": 21,
      "start": 141.6,
      "end": 144.5,
      "text": "夜又来了，这一次，人间自己点起星星"
    },
    {
      "id": 22,
      "start": 144.8,
      "end": 150.6,
      "text": "东风夜放花千树，更吹落，星如雨"
    },
    {
      "id": 23,
      "start": 151,
      "end": 155.8,
      "text": "凤箫声动，玉壶光转，一夜鱼龙舞"
    },
    {
      "id": 24,
      "start": 157.4,
      "end": 164.6,
      "text": "众里寻他千百度，蓦然回首，那人却在，灯火阑珊处"
    },
    {
      "id": 25,
      "start": 166.2,
      "end": 171,
      "text": "写诗的人，都已走远，月亮，还是那一个"
    },
    {
      "id": 26,
      "start": 171.4,
      "end": 179.5,
      "text": "江月何年初照人"
    },
    {
      "id": 27,
      "start": 174.6,
      "end": 179.5,
      "text": "今夜，照你"
    }
  ]
}